MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/firstline?retryWrites=true&w=majority"
AUTH_SECRET="<generate with: openssl rand -hex 32>"


# Set to 1 only when running behind a proxy that overwrites x-forwarded-for
# (Vercel, or your own reverse proxy). Left unset, the per-IP login throttle
# falls back to one shared bucket rather than trusting a spoofable header.
TRUSTED_PROXY=0
